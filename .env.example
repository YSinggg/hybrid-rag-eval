# Provider mode: "auto" (uses Gemini if GEMINI_API_KEY is set, otherwise local),
# "gemini", or "local"
RAG_PROVIDER=auto

# Optional: set your Google AI Studio key to enable Gemini 3.8 Flash + gemini-embedding-001
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Retrieval & chunking defaults
CHUNK_SIZE=450
CHUNK_OVERLAP=80
TOP_K=4
RRF_K=60
MIN_RELEVANCE_SCORE=0.01
